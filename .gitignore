# Data directories wholesale - data lives in Dropbox, never in git
original_data/*
modified_data/*
notes/*

# Data formats, belt and suspenders
*.csv
*.dta
*.RData
*.rds
*.parquet
*.shp
*.dbf
*.json

# LaTeX and editor detritus
*.log
*.aux
*.bbl
*.blg
*.out
*.synctex.gz
__pycache__/*
.vscode/*
.Rproj.user/*
.Rhistory
.DS_Store
.claude/settings.local.json
.playwright-mcp/

# Exceptions: small data shipped so a fresh clone runs out of the box
# (the ~210MB AEI release itself is auto-downloaded by the cleaning script)
!original_data/primary_dates/
!original_data/primary_dates/**
!modified_data/aei_election_topics.csv
!modified_data/aei_did_data.csv

# Out-of-date full paper draft stays local only
draft/full_paper_draft_jul2026/

# Ship the small Google Trends pulls and derived search panel too
!original_data/google_trends/
!original_data/google_trends/**
original_data/google_trends/*.json
!modified_data/google_trends_weekly.csv
!modified_data/search_did_data.csv

# LaTeX scratch from rendering post tables to images
output/post/_tex/
