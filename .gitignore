# Data directories wholesale - data lives in Dropbox, never in git
original_data/*
modified_data/*
notes/*

# Local working material not part of the blog-post pipeline
draft/
code/xarchive/
output/_archive/
.playwright-mcp/

# Data formats, belt and suspenders
*.csv
*.dta
*.RData
*.rds
*.parquet
*.shp
*.dbf
*.json

# LaTeX and editor detritus
*.log
*.aux
*.bbl
*.blg
*.out
*.synctex.gz
__pycache__/*
.vscode/*
.Rproj.user/*
.Rhistory
.DS_Store
.claude/settings.local.json

# Exceptions: small data shipped so a fresh clone runs out of the box
# (the ~210MB AEI release itself is auto-downloaded by the cleaning script)
!original_data/primary_dates/
!original_data/primary_dates/**
!modified_data/us_topic_shares.csv
!modified_data/country_politics.csv
!modified_data/global_context.csv
!modified_data/state_topic_panel.csv
!modified_data/did_panel.csv
!modified_data/topic_effects.csv
!modified_data/null_distribution.csv
*.jpeg
